do
    local function warpTo(plr)
        local c = player.Character
        local tc = plr and plr.Character
        local th = tc and tc:FindFirstChild("HumanoidRootPart")
        if c and th and c:FindFirstChild("HumanoidRootPart") then
            c:PivotTo(th.CFrame * CFrame.new(0, 0, 3))
            return true
        end
        return false
    end

    local function warpToRole(role, missKey)
        if NX.fetchNow then NX.fetchNow() end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and NX.getRole and NX.getRole(plr) == role then
                if not warpTo(plr) then NX.toast("noChar") end
                return
            end
        end
        NX.toast(missKey)
    end

