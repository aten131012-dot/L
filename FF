    local function sideButton(y, key, color, bg)
        local b = make("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.45, y),
            Size = UDim2.fromOffset(70, 70), BackgroundColor3 = bg, TextColor3 = WHITE,
            Font = Enum.Font.GothamBold, TextSize = 13, Text = TEXT[lang][key],
            AutoButtonColor = false, Visible = false, ZIndex = 20,
        }, gui)
        round(b, 16)
        stroke(b, color, 2.5)
        grad(b, WHITE, Color3.fromRGB(190, 190, 200), 90)
        labelRefs[b] = key -- ทำให้ข้อความเปลี่ยนตามภาษา
        return b
    end

    local throwBtn = sideButton(0, "btnThrow", RED, Color3.fromRGB(70, 16, 30))
    local shootBtn = sideButton(84, "btnShoot", Color3.fromRGB(60, 140, 255), Color3.fromRGB(16, 40, 90))

    -- ปุ่มปามีด: ปาทุกครั้งที่กด (เลือกคนที่เห็นตัวใกล้สุดก่อน ถ้าไม่มีก็ปาใส่คนใกล้สุด)
    local busyT = false
    throwBtn.Activated:Connect(function()
        if busyT then return end
        busyT = true
        local ok, err = pcall(function()
            local r = W.nearest(nil, true)
            if not r then r = W.nearest(nil, false) end
            if not r then NX.toast("noTarget") return end
            if W.throwAt(r, false) then NX.toast("thrown") end
        end)
        if not ok then warn("[NXTHROW]", err) end
        busyT = false
    end)

    -- ปุ่มยิง: ยิงฆาตกรทุกครั้งที่กด
    local busyS = false
    shootBtn.Activated:Connect(function()
        if busyS then return end
        busyS = true
        local ok, err = pcall(function()
            local r = W.murdererTarget(true)
            if not r then NX.toast("noMurder") return end
            if W.shootAt(r, false) then NX.toast("shotDone") end
        end)
        if not ok then warn("[NXSHOOT]", err) end
        busyS = false
    end)

    -- ปามีด/ยิง อัตโนมัติ: ทำงานเฉพาะตอนมองเห็นเป้าจริง
    local lastFetch = 0
    task.spawn(function()
        local lastS, lastT = 0, 0
        while gui.Parent do
            task.wait(0.1)
            if (K.aShoot or K.aThrow) and not NX.flinging then
                pcall(function()
                    local c, hrp, hum = W.myParts()
                    if not (c and hrp and hum and hum.Health > 0) then return end

                    if K.aShoot and os.clock() - lastS > 0.4 and W.findTool(W.isGun) then
                        if NX.fetchNow and os.clock() - lastFetch > 1.5 then
                            lastFetch = os.clock()
                            NX.fetchNow()
                        end
                        local r, ch = W.murdererTarget(false)
                        if r and (r.Position - hrp.Position).Magnitude <= W.RANGE_GUN and W.canSee(ch, r) then
                            if W.shootAt(r, true) then lastS = os.clock() else lastS = os.clock() + 2 end
                        end
                    end

                    if K.aThrow and os.clock() - lastT > 0.8 and W.findTool(W.isKnife) then
                        local r = W.nearest(W.RANGE_KNIFE, true)
                        if r then
                            if W.throwAt(r, true) then lastT = os.clock() else lastT = os.clock() + 2 end
                        end
                    end
                end)
            end
        end
    end)

    makeToggle(murderPage, 1, "mAuto", "mAutoD", function(v) K.auto = v end)
    makeToggle(murderPage, 2, "mAll", "mAllD", function(v) K.all = v end)
    makeToggle(murderPage, 3, "mThrow", "mThrowD", function(v) K.throw = v throwBtn.Visible = v end)
    makeToggle(murderPage, 4, "sShoot", "sShootD", function(v) K.shoot = v shootBtn.Visible = v end)
    makeToggle(murderPage, 5, "aThrow", "aThrowD", function(v) K.aThrow = v end)
    makeToggle(murderPage, 6, "aShoot", "aShootD", function(v) K.aShoot = v end)

    NX.onUnload(function()
        for k in pairs(K) do K[k] = false end
    end)
end--// ส่วน 8/12 : หมวดตัวละคร (ทะลุ สปีด กระโดด บิน TP กันฟลิ้ง)
do
    local P = { noclip = false, speed = false, jump = false, fly = false, tp = false, anti = false }
    local WALK_BASE, WALK_ADD = 16, 100
    local JUMP_BASE, JUMP_ADD = 50, 100
    local FLY_SPEED = 66

    local function myParts()
        local c = player.Character
        return c, c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
    end

    local orig = setmetatable({}, { __mode = "k" })
    local noclipWas = false
    NX.bind(RunService.Stepped, function()
        local c = player.Character
        if not c then return end
        if P.noclip and not NX.flinging then
            noclipWas = true
            for _, d in ipairs(c:GetDescendants()) do
                if d:IsA("BasePart") then
                    if orig[d] == nil then orig[d] = d.CanCollide end
                    d.CanCollide = false
                end
            end
        elseif noclipWas then
            noclipWas = false
            for part, v in pairs(orig) do
                if part.Parent then part.CanCollide = v end
                orig[part] = nil
            end
        end
    end)

    NX.bind(RunService.Heartbeat, function()
        local _, _, hum = myParts()
        if not hum then return end
        if P.speed then hum.WalkSpeed = WALK_BASE + WALK_ADD end
        if P.jump then
            hum.UseJumpPower = true
            hum.JumpPower = JUMP_BASE + JUMP_ADD
        end
    end)

    local flyBV, flyBG
    local function stopFly()
        if flyBV then flyBV:Destroy() flyBV = nil end
        if flyBG then flyBG:Destroy() flyBG = nil end
        local _, _, hum = myParts()
        if hum then hum.AutoRotate = true end
    end

    local function startFly()
        local _, hrp, hum = myParts()
        if not hrp then return end
        stopFly()
        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        flyBV.Velocity = Vector3.new(0, 0, 0)
        flyBV.Parent = hrp
        flyBG = Instance.new("BodyGyro")
        flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        flyBG.P = 9e4
        flyBG.CFrame = hrp.CFrame
        flyBG.Parent = hrp
        if hum then hum.AutoRotate = false end
    end

    NX.bind(RunService.RenderStepped, function()
        if not P.fly then return end
        if NX.flinging or NX.floating then
            if flyBV then stopFly() end
            return
        end
        local _, hrp, hum = myParts()
        local cam = workspace.CurrentCamera
        if not (hrp and hum and cam) then return end
        if not (flyBV and flyBV.Parent == hrp) then startFly() end
        if not flyBV then return end
        local look = cam.CFrame.LookVector
        local right = cam.CFrame.RightVector
        local fl = Vector3.new(look.X, 0, look.Z)
        local fr = Vector3.new(right.X, 0, right.Z)
        local vel = Vector3.new(0, 0, 0)
        local md = hum.MoveDirection
        if md.Magnitude > 0.05 and fl.Magnitude > 0.01 and fr.Magnitude > 0.01 then
            vel = (look * md:Dot(fl.Unit) + right * md:Dot(fr.Unit)) * FLY_SPEED
        end
        flyBV.Velocity = vel
        if flyBG and fl.Magnitude > 0.01 then
            flyBG.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + fl)
        end
    end)

    local tpTool
    local function giveTool()
        if tpTool and tpTool.Parent then return end
        local bp = player:FindFirstChild("Backpack")
        if not bp then return end
        tpTool = Instance.new("Tool")
        tpTool.Name = "TP NEXORA"
        tpTool.ToolTip = "TP NEXORA"
        tpTool.RequiresHandle = false
        tpTool.CanBeDropped = false
        tpTool.Activated:Connect(function()
            local c = player.Character
            local mouse = player:GetMouse()
            if c and mouse and mouse.Hit then
                c:PivotTo(CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0)))
            end
        end)
        tpTool.Parent = bp
    end

    task.spawn(function()
        while gui.Parent do
            task.wait(1)
            if P.tp then giveTool() end
        end
    end)

    NX.bind(RunService.Stepped, function()
        if not P.anti or NX.flinging then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character then
                for _, d in ipairs(plr.Character:GetDescendants()) do
                    if d:IsA("BasePart") then d.CanCollide = false end
                end
            end
        end
    end)

    NX.bind(RunService.Heartbeat, function()
        if not P.anti or NX.flinging then return end
        local _, hrp = myParts()
        if hrp and (hrp.AssemblyLinearVelocity.Magnitude > 250 or hrp.AssemblyAngularVelocity.Magnitude > 60) then
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end)

    makeToggle(playersPage, 1, "pNoclip", "pNoclipD", function(v) P.noclip = v end)
    makeToggle(playersPage, 2, "pSpeed", "pSpeedD", function(v)
        P.speed = v
        if not v then
            local _, _, hum = myParts()
            if hum then hum.WalkSpeed = WALK_BASE end
        end
    end)
    makeToggle(playersPage, 3, "pJump", "pJumpD", function(v)
        P.jump = v
        if not v then
            local _, _, hum = myParts()
            if hum then hum.JumpPower = JUMP_BASE end
        end
    end)
    makeToggle(playersPage, 4, "pFly", "pFlyD", function(v)
        P.fly = v
        if not v then stopFly() end
    end)
    makeToggle(playersPage, 5, "pTp", "pTpD", function(v)
        P.tp = v
        if v then giveTool() elseif tpTool then tpTool:Destroy() tpTool = nil end
    end)
    makeToggle(playersPage, 6, "pAnti", "pAntiD", function(v) P.anti = v end)

    NX.onUnload(function()
        for k in pairs(P) do P[k] = false end
        stopFly()
        local _, _, hum = myParts()
        if hum then
            hum.WalkSpeed = WALK_BASE
            hum.JumpPower = JUMP_BASE
        end
        for part, v in pairs(orig) do
            if part.Parent then part.CanCollide = v end
            orig[part] = nil
        end
        if tpTool then tpTool:Destroy() tpTool = nil end
    end)
end--// ส่วน 9/12 : หมวดระบบ (ตั้งค่า)
do
    local S = { full = false, boost = false, fov = false, zoom = false, ijump = false, void = false }
    local zoomOrig = player.CameraMaxZoomDistance
    local lightSaved, boostSaved = nil, nil

    local function myParts()
        local c = player.Character
        return c, c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
    end

    local function applyFull()
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.FogStart = 1e6
        Lighting.FogEnd = 1e6
        Lighting.Ambient = Color3.fromRGB(200, 200, 200)
        Lighting.OutdoorAmbient = Color3.fromRGB(200, 200, 200)
    end
    local function restoreFull()
        if not lightSaved then return end
        for k, v in pairs(lightSaved) do pcall(function() Lighting[k] = v end) end
        lightSaved = nil
    end
    makeToggle(settingsPage, 1, "sFull", "sFullD", function(v)
        S.full = v
        if v then
            lightSaved = lightSaved or {
                Brightness = Lighting.Brightness, ClockTime = Lighting.ClockTime,
                FogStart = Lighting.FogStart, FogEnd = Lighting.FogEnd,
                Ambient = Lighting.Ambient, OutdoorAmbient = Lighting.OutdoorAmbient,
            }
            applyFull()
        else
            restoreFull()
        end
    end)
    task.spawn(function()
        while gui.Parent do
            task.wait(0.5)
            if S.full then pcall(applyFull) end
        end
    end)

    local function boostOn()
        if boostSaved then return end
        boostSaved = { shadows = Lighting.GlobalShadows, effects = {} }
        pcall(function() boostSaved.quality = settings().Rendering.QualityLevel end)
        Lighting.GlobalShadows = false
        for _, e in ipairs(Lighting:GetChildren()) do
            if e:IsA("PostEffect") then
                boostSaved.effects[e] = e.Enabled
                e.Enabled = false
            end
        end
        pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    end
    local function boostOff()
        if not boostSaved then return end
        Lighting.GlobalShadows = boostSaved.shadows
        for e, en in pairs(boostSaved.effects) do
            if e.Parent then e.Enabled = en end
        end
        if boostSaved.quality then
            pcall(function() settings().Rendering.QualityLevel = boostSaved.quality end)
        end
        boostSaved = nil
    end
    makeToggle(settingsPage, 2, "sBoost", "sBoostD", function(v)
        S.boost = v
        if v then boostOn() else boostOff() end
    end)

    makeToggle(settingsPage, 3, "sFov", "sFovD", function(v)
        S.fov = v
        if not v and workspace.CurrentCamera then workspace.CurrentCamera.FieldOfView = 70 end
    end)
    NX.bind(RunService.RenderStepped, function()
        if S.fov and workspace.CurrentCamera then workspace.CurrentCamera.FieldOfView = 100 end
    end)

    makeToggle(settingsPage, 4, "sZoom", "sZoomD", function(v)
        S.zoom = v
        pcall(function() player.CameraMaxZoomDistance = v and 500 or zoomOrig end)
    end)

    NX.bind(UserInputService.JumpRequest, function()
        if not S.ijump then return end
        local _, _, hum = myParts()
