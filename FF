local function round(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = obj
end

local function stroke(obj, color, thickness)
    local s = Instance.new("UIStroke")
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Color = color
    s.Thickness = thickness or 1
    s.Parent = obj
    return s
end

local function make(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props) do obj[k] = v end
    obj.Parent = parent
    return obj
end

local function tween(obj, duration, props, style)
    local t = TweenService:Create(obj,
        TweenInfo.new(duration, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function grad(obj, c0, c1, rot)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(c0, c1)
    g.Rotation = rot or 90
    g.Parent = obj
    return g
end

NX.conns, NX.cleanups = {}, {}
function NX.bind(signal, fn)
    local c = signal:Connect(fn)
    NX.conns[#NX.conns + 1] = c
    return c
end
function NX.onUnload(fn) NX.cleanups[#NX.cleanups + 1] = fn end
function NX.unload()
    NX.dead = true
    for _, f in ipairs(NX.cleanups) do pcall(f) end
    for _, c in ipairs(NX.conns) do pcall(function() c:Disconnect() end) end
    pcall(function() gui:Destroy() end)
    if env.NX_UNLOAD == NX.unload then env.NX_UNLOAD = nil end
end
env.NX_UNLOAD = NX.unload

