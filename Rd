    local SCRIPT_ID   = "PUT_YOUR_LUARMOR_SCRIPT_ID_HERE"
    local GET_KEY_URL = "https://ads.luarmor.net/get_key?for=PUT_YOUR_LINK_HERE"
    local DISCORD     = "https://discord.gg/Qdaj957G4"
    local LOGO        = "rbxassetid://119290932517877"
    local KEY_HOURS   = 6 -- ใช้แสดงข้อความเท่านั้น อายุคีย์จริงตั้งที่ Luarmor
    local SAVE_DIR    = "NEXORA"
    local SAVE_FILE   = "NEXORA/Key.txt"

    ------------------------------------------------------------ บริการ + สี
    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService")
    local RunService = game:GetService("RunService")
    local Lighting = game:GetService("Lighting")
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    local env = (getgenv and getgenv()) or _G

    local RED     = Color3.fromRGB(255, 70, 85)
    local PURPLE  = Color3.fromRGB(170, 60, 255)
    local DARK    = Color3.fromRGB(10, 10, 12)
    local BTN     = Color3.fromRGB(175, 22, 40)
    local BTN_H   = Color3.fromRGB(225, 45, 65)
    local ROWC    = Color3.fromRGB(32, 26, 30)
    local ROWC_H  = Color3.fromRGB(58, 30, 40)
    local DC      = Color3.fromRGB(88, 101, 242)
    local DC_H    = Color3.fromRGB(122, 135, 255)
    local GREEN   = Color3.fromRGB(60, 255, 90)
    local WHITE   = Color3.fromRGB(255, 255, 255)
    local GRAY    = Color3.fromRGB(200, 200, 208)

    ------------------------------------------------------------ ข้อความ ไทย / อังกฤษ
    local T = {
        th = {
            sub = "MM2 ✦ KEY SYSTEM",
            hint = "ผ่าน Linkvertise 1 ด่าน รับคีย์ใช้ได้ " .. KEY_HOURS .. " ชม.",
            ph = "วางคีย์ของคุณที่นี่",
            verify = "✅  ยืนยันคีย์", getkey = "🔑  รับคีย์", discord = "💬  Discord",
            checking = "กำลังตรวจสอบ", ok = "คีย์ถูกต้อง กำลังโหลดสคริปต์ ✓",
            LEN = "คีย์ต้องมี 32 ตัวอักษร",
            NET = "เชื่อมต่อเซิร์ฟเวอร์คีย์ไม่ได้ ลองใหม่อีกครั้ง",
            KEY_HWID_LOCKED = "คีย์ผูกกับเครื่องอื่นอยู่ รีเซ็ต HWID ผ่านบอทดิสคอร์ด",
            KEY_INCORRECT = "คีย์ไม่ถูกต้องหรือถูกลบแล้ว",
            KEY_INVALID = "รูปแบบคีย์ไม่ถูกต้อง",
            KEY_EXPIRED = "คีย์หมดอายุแล้ว กด 'รับคีย์' เพื่อรับอันใหม่",
            KEY_BANNED = "คีย์นี้ถูกแบน",
            copiedKey = "คัดลอกลิงก์รับคีย์แล้ว เอาไปวางในเบราว์เซอร์ได้เลย ✓",
            copiedDc = "คัดลอกลิงก์ดิสคอร์ดแล้ว ✓",
            noClip = "ตัวรันไม่รองรับการคัดลอก ลิงก์: ",
        },
        en = {
            sub = "MM2 ✦ KEY SYSTEM",
            hint = "Finish 1 Linkvertise step to get a key valid for " .. KEY_HOURS .. " hours",
            ph = "Paste your key here",
            verify = "✅  VERIFY KEY", getkey = "🔑  GET KEY", discord = "💬  Discord",
            checking = "Checking", ok = "Key valid, loading script ✓",
            LEN = "Key must be 32 characters",
            NET = "Can't reach the key server, try again",
            KEY_HWID_LOCKED = "Key is locked to another device. Reset HWID via the Discord bot",
            KEY_INCORRECT = "Key is wrong or has been deleted",
            KEY_INVALID = "Invalid key format",
            KEY_EXPIRED = "Key expired. Press 'GET KEY' for a new one",
            KEY_BANNED = "This key is banned",
            copiedKey = "Key link copied, paste it in your browser ✓",
            copiedDc = "Discord link copied ✓",
            noClip = "Executor can't copy. Link: ",
        },
    }
    local lang = "th"
    local function L(k) return T[lang][k] or k end

    ------------------------------------------------------------ ไฟล์ + คลิปบอร์ด
    local function readSaved()
        if not (isfile and readfile) then return nil end
        local ok, v = pcall(function()
            if isfile(SAVE_FILE) then return readfile(SAVE_FILE) end
        end)
        if ok and type(v) == "string" and #v > 0 then return (v:gsub("%s+", "")) end
        return nil
    end
    local function writeSaved(k)
        if not writefile then return end
        pcall(function()
            if makefolder and isfolder and not isfolder(SAVE_DIR) then makefolder(SAVE_DIR) end
            writefile(SAVE_FILE, k)
        end)
    end
    local function clearSaved()
        if delfile and isfile then
            pcall(function() if isfile(SAVE_FILE) then delfile(SAVE_FILE) end end)
        end
    end
    local function copy(text)
        local clip = setclipboard or toclipboard
        if not clip then return false end
        return (pcall(clip, text))
    end

    ------------------------------------------------------------ เช็คคีย์ผ่าน Luarmor
    local api = nil
    local function getApi()
        if api then return api end
        local ok, lib = pcall(function()
            return loadstring(game:HttpGet("https://sdkapi-public.luarmor.net/library.lua"))()
        end)
        if ok and type(lib) == "table" then
            lib.script_id = SCRIPT_ID
            api = lib
        end
        return api
    end

    -- คืนค่า: ok, code, key, message
    local function check(key)
        key = (tostring(key or ""):gsub("%s+", ""))
        if #key ~= 32 then return false, "LEN", key end
        local a = getApi()
        if not a then return false, "NET", key end
        local ok, st = pcall(a.check_key, key)
        if not ok or type(st) ~= "table" then return false, "NET", key end
        if st.code == "KEY_VALID" then return true, "OK", key end
        return false, st.code or "UNKNOWN", key, st.message
    end

    local function setKey(k)
        env.script_key = k
        script_key = k -- Luarmor อ่านตัวแปรนี้หลังจบ INIT
    end

    ------------------------------------------------------------ มีคีย์ที่ใช้ได้อยู่แล้ว ข้ามหน้ากรอกคีย์
    do
        local list = {}
        if type(env.script_key) == "string" and #env.script_key > 0 then
            list[#list + 1] = env.script_key
        end
        local saved = readSaved()
        if saved then list[#list + 1] = saved end
        for _, k in ipairs(list) do
            local ok, _, clean = check(k)
            if ok then
                setKey(clean)
                return
            end
        end
        if saved then clearSaved() end
    end

    ------------------------------------------------------------ สร้าง UI
    local old = playerGui:FindFirstChild("NEXORA_KEY")
    if old then old:Destroy() end

    local function make(class, props, parent)
        local o = Instance.new(class)
        for k, v in pairs(props) do o[k] = v end
        o.Parent = parent
        return o
    end
    local function round(o, r) return make("UICorner", { CornerRadius = UDim.new(0, r) }, o) end
    local function stroke(o, c, t)
        return make("UIStroke", {
            Color = c, Thickness = t or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, o)
    end
    local function gradient(o, c0, c1, rot)
        return make("UIGradient", { Color = ColorSequence.new(c0, c1), Rotation = rot or 90 }, o)
    end
    local function tw(o, t, props, style)
        local x = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
        x:Play()
        return x
    end

    local blur = make("BlurEffect", { Size = 0 }, Lighting)
    tw(blur, 0.4, { Size = 16 })

    local gui = make("ScreenGui", {
        Name = "NEXORA_KEY", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 1001,
    }, playerGui)

    local dim = make("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0, Active = true,
    }, gui)
    tw(dim, 0.4, { BackgroundTransparency = 0.45 })

    local win = make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(340, 318), BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, gui)
    round(win, 20)
    gradient(win, Color3.fromRGB(34, 12, 22), Color3.fromRGB(8, 8, 12), 90)

    local winStroke = stroke(win, WHITE, 2)
    local strokeGrad = make("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, RED),
            ColorSequenceKeypoint.new(0.5, PURPLE),
            ColorSequenceKeypoint.new(1, RED),
        }),
        Rotation = 0,
    }, winStroke)

    -- ย่อให้พอดีจอมือถือ
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(800, 600)
    local base = math.clamp(math.min(vp.X / 380, vp.Y / 350), 0.55, 1)
    local sc = make("UIScale", { Scale = base * 0.7 }, win)
    tw(sc, 0.3, { Scale = base }, Enum.EasingStyle.Back)

    local rot = RunService.RenderStepped:Connect(function(dt)
        strokeGrad.Rotation = (strokeGrad.Rotation + dt * 80) % 360
    end)

    -- แถบไฟด้านบน
    local accent = make("Frame", {
        Position = UDim2.new(0, 28, 0, 0), Size = UDim2.new(1, -56, 0, 3),
        BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, win)
    round(accent, 2)
    make("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, RED),
            ColorSequenceKeypoint.new(0.5, PURPLE),
            ColorSequenceKeypoint.new(1, RED),
        }),
    }, accent)

    -- หัว: โลโก้ + ชื่อ
    local logo = make("ImageLabel", {
        Position = UDim2.new(0, 16, 0, 16), Size = UDim2.fromOffset(44, 44),
        BackgroundColor3 = DARK, Image = LOGO, ScaleType = Enum.ScaleType.Fit,
    }, win)
    round(logo, 12)
    stroke(logo, RED, 1.5)

    local title = make("TextLabel", {
        Position = UDim2.new(0, 70, 0, 14), Size = UDim2.fromOffset(180, 28), BackgroundTransparency = 1,
        Text = "NEXORA", TextColor3 = WHITE, Font = Enum.Font.GothamBlack, TextSize = 24,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, win)
    gradient(title, RED, PURPLE, 0)

    local sub = make("TextLabel", {
        Position = UDim2.new(0, 70, 0, 42), Size = UDim2.fromOffset(200, 16), BackgroundTransparency = 1,
        Text = "", TextColor3 = Color3.fromRGB(170, 170, 182), Font = Enum.Font.GothamBold, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, win)

    local close = make("TextButton", {
        AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 16), Size = UDim2.fromOffset(30, 30),
        BackgroundColor3 = Color3.fromRGB(44, 16, 26), Text = "×", TextColor3 = RED,
        Font = Enum.Font.GothamBold, TextSize = 20, AutoButtonColor = false, BorderSizePixel = 0,
    }, win)
    round(close, 9)

    make("Frame", {
        Position = UDim2.new(0, 16, 0, 72), Size = UDim2.new(1, -32, 0, 1),
        BackgroundColor3 = Color3.fromRGB(70, 22, 36), BorderSizePixel = 0,
    }, win)

    local hint = make("TextLabel", {
        Position = UDim2.new(0, 16, 0, 80), Size = UDim2.new(1, -32, 0, 22), BackgroundTransparency = 1,
        Text = "", TextColor3 = GRAY, Font = Enum.Font.Gotham, TextSize = 11, TextWrapped = true,
    }, win)

    -- ช่องกรอกคีย์
    local keyFrame = make("Frame", {
        Position = UDim2.new(0, 16, 0, 108), Size = UDim2.new(1, -32, 0, 46),
        BackgroundColor3 = DARK, BorderSizePixel = 0,
    }, win)
    round(keyFrame, 12)
    local keyStroke = stroke(keyFrame, Color3.fromRGB(90, 20, 36), 1.5)
    make("TextLabel", {
        Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(0, 28, 1, 0), BackgroundTransparency = 1,
        Text = "🔑", TextSize = 18, Font = Enum.Font.Gotham, TextColor3 = WHITE,
    }, keyFrame)
    local box = make("TextBox", {
        Position = UDim2.new(0, 44, 0, 0), Size = UDim2.new(1, -54, 1, 0), BackgroundTransparency = 1,
        Text = "", PlaceholderText = "", PlaceholderColor3 = Color3.fromRGB(120, 120, 132),
        TextColor3 = WHITE, Font = Enum.Font.Gotham, TextSize = 12, ClearTextOnFocus = false,
        TextXAlignment = Enum.TextXAlignment.Left, ClipsDescendants = true,
    }, keyFrame)

    -- ข้อความสถานะ
    local status = make("TextLabel", {
        Position = UDim2.new(0, 16, 0, 160), Size = UDim2.new(1, -32, 0, 30), BackgroundTransparency = 1,
        Text = "", TextColor3 = GRAY, Font = Enum.Font.GothamBold, TextSize = 11, TextWrapped = true,
    }, win)
    local function setStatus(text, color)
        status.Text = text
        status.TextColor3 = color
    end

    -- ปุ่ม
    local function mkButton(pos, size, normal, over, textSize)
        local b = make("TextButton", {
            Position = pos, Size = size, BackgroundColor3 = normal, Text = "", TextColor3 = WHITE,
            Font = Enum.Font.GothamBold, TextSize = textSize or 13, AutoButtonColor = false,
            BorderSizePixel = 0, TextStrokeColor3 = Color3.new(0, 0, 0), TextStrokeTransparency = 0.5,
        }, win)
        round(b, 12)
        gradient(b, WHITE, Color3.fromRGB(190, 190, 200), 90)
        local function go(c) tw(b, 0.12, { BackgroundColor3 = c }) end
        b.MouseEnter:Connect(function() go(over) end)
        b.MouseLeave:Connect(function() go(normal) end)
        b.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
                or i.UserInputType == Enum.UserInputType.Touch then go(over) end
        end)
        b.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1
                or i.UserInputType == Enum.UserInputType.Touch then go(normal) end
        end)
        return b
    end

    local verifyBtn = mkButton(UDim2.new(0, 16, 0, 194), UDim2.new(1, -32, 0, 44), BTN, BTN_H, 15)
    local getBtn = mkButton(UDim2.new(0, 16, 0, 246), UDim2.new(0.5, -22, 0, 38), ROWC, ROWC_H, 12)
    stroke(getBtn, RED, 1.5)
    local dcBtn = mkButton(UDim2.new(0.5, 6, 0, 246), UDim2.new(0.5, -22, 0, 38), DC, DC_H, 12)

    -- ท้ายหน้าต่าง: เวอร์ชัน + สลับภาษา
    make("TextLabel", {
        Position = UDim2.new(0, 16, 0, 292), Size = UDim2.fromOffset(150, 18), BackgroundTransparency = 1,
        Text = "NEXORA V8.1", TextColor3 = Color3.fromRGB(120, 120, 132), Font = Enum.Font.GothamBold,
        TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left,
    }, win)
    local function langButton(x, text)
        local b = make("TextButton", {
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, x, 0, 290), Size = UDim2.fromOffset(42, 20),
            BackgroundColor3 = ROWC, Text = text, TextColor3 = WHITE, Font = Enum.Font.GothamBold,
            TextSize = 10, AutoButtonColor = false, BorderSizePixel = 0,
        }, win)
        round(b, 7)
        return b
    end
    local thB = langButton(-62, "ไทย")
    local enB = langButton(-16, "EN")

    local function applyLang()
        sub.Text = L("sub")
        hint.Text = L("hint")
        box.PlaceholderText = L("ph")
        verifyBtn.Text = L("verify")
        getBtn.Text = L("getkey")
        dcBtn.Text = L("discord")
        thB.BackgroundColor3 = lang == "th" and BTN or ROWC
        enB.BackgroundColor3 = lang == "en" and BTN or ROWC
        setStatus("", GRAY)
    end
    thB.Activated:Connect(function() lang = "th" applyLang() end)
    enB.Activated:Connect(function() lang = "en" applyLang() end)
    applyLang()

    -- ขอบช่องกรอกเรืองแดงตอนพิมพ์
    box.Focused:Connect(function() tw(keyStroke, 0.15, { Color = RED }) end)

    ------------------------------------------------------------ การทำงาน
    local done, chosen = false, nil
    local busy, spinner = false, nil

    local function shake()
        local home = win.Position
        for i = 1, 5 do
            local dx = (i % 2 == 0 and -1 or 1) * (12 - i * 2)
            win.Position = home + UDim2.fromOffset(dx, 0)
            task.wait(0.04)
        end
        win.Position = home
    end

    local function doVerify()
        if busy then return end
        busy = true
        local token = {}
        spinner = token
        task.spawn(function()
            local n = 0
            while spinner == token do
                n = n % 3 + 1
                setStatus(L("checking") .. string.rep(".", n), WHITE)
                task.wait(0.3)
            end
        end)

        local ok, code, key, msg = check(box.Text)
        spinner = nil

        if ok then
            setStatus(L("ok"), GREEN)
            tw(keyStroke, 0.15, { Color = GREEN })
            writeSaved(key)
            task.wait(0.8)
            chosen = key
            done = true
        else
            setStatus(T[lang][code] or (tostring(msg or "Error") .. " [" .. tostring(code) .. "]"), RED)
            tw(keyStroke, 0.15, { Color = RED })
            task.spawn(shake)
            busy = false
        end
    end

    verifyBtn.Activated:Connect(doVerify)
    box.FocusLost:Connect(function(enter)
        box.Text = (box.Text:gsub("%s+", ""))
        tw(keyStroke, 0.15, { Color = Color3.fromRGB(90, 20, 36) })
        if enter then doVerify() end
    end)

    getBtn.Activated:Connect(function()
        if copy(GET_KEY_URL) then
            setStatus(L("copiedKey"), GREEN)
        else
            setStatus(L("noClip") .. GET_KEY_URL, RED)
        end
    end)
    dcBtn.Activated:Connect(function()
        if copy(DISCORD) then
            setStatus(L("copiedDc"), GREEN)
        else
            setStatus(L("noClip") .. DISCORD, RED)
        end
    end)
    close.Activated:Connect(function()
        chosen = nil
        done = true
    end)

    ------------------------------------------------------------ รอจนกรอกคีย์ผ่าน (Luarmor ต้องรอตรงนี้)
    while not done do task.wait(0.1) end

    pcall(function() rot:Disconnect() end)
    tw(sc, 0.22, { Scale = base * 0.7 })
    tw(dim, 0.25, { BackgroundTransparency = 1 })
    tw(blur, 0.25, { Size = 0 })
    task.wait(0.3)
    pcall(function() gui:Destroy() end)
    pcall(function() blur:Destroy() end)

    if chosen then
        setKey(chosen)
    else
        -- ผู้เล่นปิดหน้าต่างโดยไม่กรอกคีย์ ไม่โหลดสคริปต์ต่อ
        repeat task.wait(60) until false
    end
end)--// NEXORA | MM2 V8.1 | ส่วน 1/12 (วางส่วน 1-12 ต่อกันตามลำดับให้ครบ)
