do
    local K = { auto = false, all = false, throw = false, shoot = false, pierceT = false, pierceS = false }

    local function myParts()
        local c = player.Character
        return c, c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
    end

    local function alive(plr)
        local ch = plr.Character
        local h = ch and ch:FindFirstChildOfClass("Humanoid")
        local r = ch and ch:FindFirstChild("HumanoidRootPart")
        if h and r and h.Health > 0 then return ch, r end
        return nil
    end

    local function hasTag(t, tag)
        local ok, r = pcall(function() return t:HasTag(tag) end)
        return ok and r
    end

    local function isKnife(t)
        return t:IsA("Tool") and (t.Name:lower():find("knife") ~= nil or hasTag(t, "Weapon_Knife"))
    end

    local function isGun(t)
        if not t:IsA("Tool") then return false end
        local n = t.Name:lower()
        return n:find("gun") ~= nil or n:find("revolver") ~= nil or hasTag(t, "Weapon_Gun")
    end

    local function findTool(test)
        local c = player.Character
        if c then
            for _, t in ipairs(c:GetChildren()) do if test(t) then return t end end
        end
        local bp = player:FindFirstChild("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do if test(t) then return t end end
        end
        return nil
    end

    -- ถืออยู่แล้วก็ใช้ทันที ไม่รอ
    local function equip(t)
        if not t then return nil end
        local c, _, hum = myParts()
        if not (c and hum) then return nil end
        if t.Parent ~= c then
            pcall(function() hum:EquipTool(t) end)
            task.wait(0.1)
        end
        if t.Parent == c then return t end
        return nil
    end
    local function equipKnife() return equip(findTool(isKnife)) end
    local function equipGun() return equip(findTool(isGun)) end

    local function stab(knife, targetRoot)
        pcall(function() knife:Activate() end)
        local handle = knife:FindFirstChild("Handle")
        if firetouchinterest and handle then
            pcall(firetouchinterest, targetRoot, handle, 0)
            pcall(firetouchinterest, targetRoot, handle, 1)
        end
    end

    -- 1) ออโต้ฆ่า
    task.spawn(function()
        while gui.Parent do
            task.wait(0.15)
            if K.auto then
                local ok, err = pcall(function()
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if not K.auto then break end
                        if plr ~= player then
                            local ch, r = alive(plr)
                            local _, hrp = myParts()
                            if ch and hrp then
                                local knife = equipKnife()
                                if not knife then NX.toast("noKnife") task.wait(1) break end
                                local pos = (r.CFrame * CFrame.new(0, 0, 3)).Position
                                hrp.CFrame = CFrame.lookAt(pos, r.Position)
                                task.wait(0.12)
                                stab(knife, r)
                                task.wait(0.35)
                            end
                        end
                    end
                end)
                if not ok then warn("[NXKILL]", err) end
            end
        end
    end)

    -- 2) ฆ่าทั้งแมพ (ลากมาข้างหน้าเฉพาะฝั่งเรา)
    NX.bind(RunService.Heartbeat, function()
        if not K.all then return end
        local _, hrp = myParts()
        if not hrp then return end
        local n = 0
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                local ch, r = alive(plr)
                if ch then
                    n += 1
                    local col = (n - 1) % 5 - 2
                    local row = math.floor((n - 1) / 5)
                    r.CFrame = hrp.CFrame * CFrame.new(col * 2, 0, -4 - row * 2)
                    r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            end
        end
    end)

    task.spawn(function()
        while gui.Parent do
            task.wait(0.3)
            if K.all then
                pcall(function()
                    local knife = equipKnife()
                    if not knife then return end
                    pcall(function() knife:Activate() end)
                    for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= player then
                            local ch, r = alive(plr)
                            if ch then stab(knife, r) end
                        end
                    end
                end)
            end
        end
    end)

    local function sideButton(y, text, color, bg)
        local b = make("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.45, y),
            Size = UDim2.fromOffset(70, 70), BackgroundColor3 = bg, TextColor3 = WHITE,
            Font = Enum.Font.GothamBold, TextSize = 13, Text = text, AutoButtonColor = false,
            Visible = false, ZIndex = 20,
        }, gui)
        round(b, 16)
        stroke(b, color, 2.5)
        grad(b, WHITE, Color3.fromRGB(190, 190, 200), 90)
        return b
    end

    local function findRemote(root, names)
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                local n = d.Name:lower() .. "/" .. (d.Parent and d.Parent.Name:lower() or "")
                for _, w in ipairs(names) do
                    if n:find(w) then return d end
                end
            end
        end
        return nil
    end

    local function dump(tag, root)
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("RemoteEvent") or d:IsA("RemoteFunction") then
                print("[NX " .. tag .. "]", d:GetFullName(), d.ClassName)
            end
        end
    end

    local function fire(remote, ...)
        local a = table.pack(...)
        if remote:IsA("RemoteFunction") then
            task.spawn(function() pcall(function() remote:InvokeServer(table.unpack(a, 1, a.n)) end) end)
        else
            pcall(function() remote:FireServer(table.unpack(a, 1, a.n)) end)
        end
    end

    local function nearestRoot()
        local _, hrp = myParts()
        if not hrp then return nil end
        local best, bd
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                local ch, r = alive(plr)
                if ch then
                    local d = (r.Position - hrp.Position).Magnitude
                    if not bd or d < bd then best, bd = r, d end
                end
            end
        end
        return best
    end

    local function murdererRoot()
        if NX.fetchNow then NX.fetchNow() end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and NX.getRole and NX.getRole(plr) == "Murderer" then
                local ch, r = alive(plr)
                if ch then return r end
            end
        end
        return nil
    end

    -- โหมดทะลุกำแพง: วาร์ปไปข้างเป้าหมายแว๊บเดียว ทำ fn แล้วกลับที่เดิม
    local function nearTarget(r, fn)
        local c, hrp = myParts()
        if not (c and hrp) then return end
        local home = hrp.CFrame
        local spot = (r.CFrame * CFrame.new(0, 0, 4)).Position
        pcall(function() c:PivotTo(CFrame.lookAt(spot, r.Position)) end)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        task.wait(0.12)
        pcall(fn, spot)
        task.wait(0.1)
        pcall(function() c:PivotTo(home) end)
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end

    -- 3) ปามีด (กดแล้วปาทันที)
    local throwBtn = sideButton(0, "🔪\nปามีด", RED, Color3.fromRGB(70, 16, 30))
    local busyT = false
    throwBtn.Activated:Connect(function()
        if busyT then return end
        busyT = true
        pcall(function()
            local knife = equipKnife()
            if not knife then NX.toast("noKnife") return end
            local r = nearestRoot()
            if not r then NX.toast("noTarget") return end
            local rem = findRemote(knife, { "throw" })
            local function go(from)
                local aim = r.Position + r.AssemblyLinearVelocity * 0.12
                if rem then
                    fire(rem, CFrame.new(from), CFrame.new(aim))
                else
                    dump("KNIFE", knife)
                    NX.toast("noRemote")
                    pcall(function() knife:Activate() end)
                end
            end
            if K.pierceT then
                nearTarget(r, go)
            else
                local _, hrp = myParts()
                if hrp then go(hrp.Position) end
            end
        end)
        busyT = false
    end)

    -- 4) ยิงฆาตกร (กดแล้วยิงทันที)
    local shootBtn = sideButton(84, "🔫\nยิง", Color3.fromRGB(60, 140, 255), Color3.fromRGB(16, 40, 90))
    local busyS = false
    shootBtn.Activated:Connect(function()
        if busyS then return end
        busyS = true
        pcall(function()
            local gun = equipGun()
            if not gun then NX.toast("noGun") return end
            local r = murdererRoot()
            if not r then NX.toast("noMurder") return end
            local rem = findRemote(gun, { "createbeam", "shoot", "fire" })
            local function go()
                local aim = r.Position + r.AssemblyLinearVelocity * 0.1
                if rem then
                    fire(rem, 1, aim, "AH2")
                else
                    dump("GUN", gun)
                    NX.toast("noRemote")
                    pcall(function() gun:Activate() end)
                end
            end
            if K.pierceS then nearTarget(r, go) else go() end
        end)
        busyS = false
    end)

    makeToggle(murderPage, 1, "mAuto", "mAutoD", function(v) K.auto = v end)
    makeToggle(murderPage, 2, "mAll", "mAllD", function(v) K.all = v end)
    makeToggle(murderPage, 3, "mThrow", "mThrowD", function(v) K.throw = v throwBtn.Visible = v end)
    makeToggle(murderPage, 4, "sShoot", "sShootD", function(v) K.shoot = v shootBtn.Visible = v end)
    makeToggle(murderPage, 5, "mThru", "mThruD", function(v) K.pierceT = v end)
    makeToggle(murderPage, 6, "sThru", "sThruD", function(v) K.pierceS = v end)
end--// ส่วน 7/12 : หมวดฟลิ้ง + หมวดฟาร์ม (เหรียญลอย ความเร็ว 20 + ANTI-AFK)
do
    local BLUE = Color3.fromRGB(40, 110, 230)
    local BLUE_H = Color3.fromRGB(85, 155, 255)
    local busy = false
    local TIMEOUT, ROUNDS = 2.5, 3

    local function hb() RunService.Heartbeat:Wait() end

    local function zeroAll(c)
        for _, d in ipairs(c:GetChildren()) do
            if d:IsA("BasePart") then
                d.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                d.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
        end
    end

    local function flingPlayer(plr)
        if busy then NX.toast("flingBusy") return end
        local c = player.Character
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        local hum = c and c:FindFirstChildOfClass("Humanoid")
        local tch = plr and plr.Character
        local troot = tch and tch:FindFirstChild("HumanoidRootPart")
        local thum = tch and tch:FindFirstChildOfClass("Humanoid")
        if not (hrp and hum and hum.Health > 0 and troot and thum and thum.Health > 0) then
            NX.toast("noChar")
            return
        end

        busy = true
        NX.flinging = true
        local homeCF = hrp.CFrame
        local startPos = troot.Position
        local cam = workspace.CurrentCamera
        local oldSubject = cam and cam.CameraSubject
        local oldFall = workspace.FallenPartsDestroyHeight
        pcall(function() workspace.FallenPartsDestroyHeight = 0 / 0 end)
        pcall(function() cam.CameraSubject = thum end)

        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
        bv.Parent = hrp

        local function pose(offset, ang)
            local cf = CFrame.new(troot.Position) * offset * ang
            pcall(function() c:PivotTo(cf) end)
            hrp.AssemblyLinearVelocity = Vector3.new(9e7, 9e8, 9e7)
            hrp.AssemblyAngularVelocity = Vector3.new(9e8, 9e8, 9e8)
            hb()
        end

        local function targetGone()
            return not (plr.Parent and plr.Character == tch and troot.Parent) or thum.Health <= 0
        end

        local flung = false
        local ok, err = pcall(function()
            for _ = 1, ROUNDS do
                local t0 = os.clock()
                local angle = 0
                while true do
                    if targetGone() or hum.Health <= 0 or not hrp.Parent then break end
                    local spd = troot.AssemblyLinearVelocity.Magnitude
                    if spd > 500 or (troot.Position - startPos).Magnitude > 300 then
                        flung = true
                        break
                    end
                    if os.clock() - t0 > TIMEOUT then break end
                    if spd < 50 then
                        angle += 100
                        local lead = CFrame.new(thum.MoveDirection * spd / 10)
                        local a = CFrame.Angles(math.rad(angle), 0, 0)
                        pose(CFrame.new(0, 1.5, 0) * lead, a)
                        pose(CFrame.new(0, -1.5, 0) * lead, a)
                        pose(CFrame.new(2.25, 1.5, -2.25) * lead, a)
                        pose(CFrame.new(-2.25, -1.5, 2.25) * lead, a)
                        pose(CFrame.new(0, 1.5, 0) * CFrame.new(thum.MoveDirection), a)
                        pose(CFrame.new(0, -1.5, 0) * CFrame.new(thum.MoveDirection), a)
                    else
                        local ws = thum.WalkSpeed
                        pose(CFrame.new(0, 1.5, ws), CFrame.Angles(math.rad(90), 0, 0))
                        pose(CFrame.new(0, -1.5, -ws), CFrame.Angles(0, 0, 0))
                        pose(CFrame.new(0, 1.5, ws), CFrame.Angles(math.rad(90), 0, 0))
                        pose(CFrame.new(0, 1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                        pose(CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(-90), 0, 0))
                        pose(CFrame.new(0, 1.5, 0), CFrame.Angles(0, 0, 0))
                    end
                end
                if flung or targetGone() or hum.Health <= 0 then break end
            end
        end)
        if not ok then warn("[NXFLING]", err) end

        bv:Destroy()
        pcall(function() cam.CameraSubject = oldSubject or hum end)
        for i = 1, 90 do
            if not (hrp.Parent and c.Parent) then break end
            pcall(function() c:PivotTo(homeCF * CFrame.new(0, 0.5, 0)) end)
            zeroAll(c)
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            hb()
            if i >= 12 and (hrp.Position - homeCF.Position).Magnitude < 15 then break end
        end
        pcall(function() workspace.FallenPartsDestroyHeight = oldFall end)
        NX.flinging = false
        busy = false
        NX.toast("flingDone")
    end

    local function flingRole(role, missKey)
        if NX.fetchNow then NX.fetchNow() end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and NX.getRole and NX.getRole(plr) == role then
                task.spawn(flingPlayer, plr)
                return
            end
        end
        NX.toast(missKey)
    end

    local function bigButton(order, key, color, hover, onClick)
        local b = make("TextButton", {
            LayoutOrder = order, Size = UDim2.new(1, -6, 0, 46), BackgroundColor3 = color,
            TextColor3 = WHITE, Font = Enum.Font.GothamBold, TextSize = 14,
            TextStrokeTransparency = 0.45, AutoButtonColor = false, BorderSizePixel = 0, Text = "",
        }, flingPage)
        round(b, 10)
        grad(b, WHITE, Color3.fromRGB(190, 190, 200), 90)
        labelRefs[b] = key
        b.MouseEnter:Connect(function() b.BackgroundColor3 = hover end)
        b.MouseLeave:Connect(function() b.BackgroundColor3 = color end)
        b.Activated:Connect(onClick)
    end

    bigButton(1, "fSheriff", BLUE, BLUE_H, function() flingRole("Sheriff", "noSheriff") end)
    bigButton(2, "fMurder", BTN, BTN_HOVER, function() flingRole("Murderer", "noMurder") end)

    local getSel = makePlayerList(flingPage, 3)
    local goBtn = cuteButton({
        LayoutOrder = 4, Size = UDim2.new(1, -6, 0, 40), Text = "", TextSize = 13,
    }, flingPage)
    round(goBtn, 10)
    labelRefs[goBtn] = "fGo"
    goBtn.Activated:Connect(function()
        local selected = getSel()
        if not selected or not selected.Parent then NX.toast("noSelect") return end
        task.spawn(flingPlayer, selected)
    end)

    NX.onUnload(function() NX.flinging = false end)
end

do
    local LIMIT = 40
    local SPEED = 20 -- ความเร็วลอย (แก้เลขนี้ได้)
    local FARM = { on = false }
    local collected, lastCont, lastFind = 0, nil, 0
    local done, target, tStart, tLimit, arrT = {}, nil, 0, 3, nil
    local lastTouch = 0
    local fv, fg = nil, nil
    local floating = false
    local orig = setmetatable({}, { __mode = "k" })
    local toastedDone = false

    local info = make("Frame", {
        LayoutOrder = 2, Size = UDim2.new(1, -6, 0, 34), BackgroundColor3 = ROW, BorderSizePixel = 0,
    }, farmPage)
    round(info, 10)
    NX.styleRow(info)
    local countLabel = make("TextLabel", {
        Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -20, 1, 0), BackgroundTransparency = 1,
        TextColor3 = WHITE, Font = Enum.Font.GothamBold, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left, Text = "🪙 0 / " .. LIMIT,
    }, info)

    local function myParts()
        local c = player.Character
        return c, c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
    end

    local function coinPart(o)
        if o:IsA("BasePart") then return o end
        return o:FindFirstChildWhichIsA("BasePart", true)
    end

    local function nextCoin(cont, hrp)
        local best, bd
        for _, o in ipairs(cont:GetChildren()) do
            local p = coinPart(o)
            if p and p.Parent and not done[p] then
                local d = (p.Position - hrp.Position).Magnitude
                if not bd or d < bd then best, bd = p, d end
            end
        end
        return best, bd
    end

    local function release()
        if fv then fv:Destroy() fv = nil end
        if fg then fg:Destroy() fg = nil end
        for part, v in pairs(orig) do
            if part.Parent then part.CanCollide = v end
            orig[part] = nil
        end
        if floating then
            floating = false
            NX.floating = false
            local _, _, hum = myParts()
            if hum then
                hum.PlatformStand = false
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            end
        end
    end

    local function engage(hrp, hum)
        if not (fv and fv.Parent == hrp) then
            if fv then fv:Destroy() end
            fv = Instance.new("BodyVelocity")
            fv.MaxForce = Vector3.new(1e7, 1e7, 1e7)
            fv.Velocity = Vector3.new(0, 0, 0)
            fv.Parent = hrp
        end
        if not (fg and fg.Parent == hrp) then
            if fg then fg:Destroy() end
            fg = Instance.new("BodyGyro")
            fg.MaxTorque = Vector3.new(1e7, 1e7, 1e7)
            fg.P = 1e5
            fg.D = 1e3
            fg.CFrame = hrp.CFrame
            fg.Parent = hrp
        end
        floating = true
        NX.floating = true
        hum.PlatformStand = true
    end

    local function resetRound()
        release()
        collected = 0
        done = {}
        target, arrT = nil, nil
        toastedDone = false
    end
    NX.bind(player.CharacterAdded, resetRound)

    local function setCount()
        countLabel.Text = "🪙 " .. collected .. " / " .. LIMIT
            .. (collected >= LIMIT and "  ✓" or (floating and "  ☁️" or ""))
    end

    NX.bind(RunService.Stepped, function()
        if not floating then return end
        local c = player.Character
        if not c then return end
        for _, d in ipairs(c:GetDescendants()) do
            if d:IsA("BasePart") then
                if orig[d] == nil then orig[d] = d.CanCollide end
                d.CanCollide = false
            end
        end
    end)

    NX.bind(RunService.Heartbeat, function()
        if not FARM.on or NX.flinging then release() return end
        local c, hrp, hum = myParts()
        if not (c and hrp and hum and hum.Health > 0) then release() return end

        if os.clock() - lastFind > 1 or (lastCont and not lastCont.Parent) then
            lastFind = os.clock()
            local f = workspace:FindFirstChild("CoinContainer", true)
            if f ~= lastCont then
                lastCont = f
                resetRound()
            end
        end
        local cont = lastCont
        setCount()

        if collected >= LIMIT then
            release()
            if not toastedDone then
                toastedDone = true
                NX.toast("cfDone")
            end
            return
        end
        if not cont then release() return end

        if target then
            if not target.Parent then
                done[target] = true
                collected += 1
                target, arrT = nil, nil
            elseif os.clock() - tStart > tLimit then
                done[target] = true
                target, arrT = nil, nil
            end
        end
        if not target then
            local coin, d0 = nextCoin(cont, hrp)
            if not coin then release() return end
            target = coin
            tStart = os.clock()
            tLimit = 1.5 + (d0 / SPEED) * 1.5
        end

        engage(hrp, hum)
        local to = target.Position - hrp.Position
        local dist = to.Magnitude
        if dist < 1.2 then
            fv.Velocity = Vector3.new(0, 0, 0)
        else
            fv.Velocity = to.Unit * math.min(SPEED, math.max(dist * 6, 12))
            local flat = Vector3.new(to.X, 0, to.Z)
            if flat.Magnitude > 0.5 then
                fg.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flat)
            end
        end

        if dist < 2.5 then
            arrT = arrT or os.clock()
            if os.clock() - arrT > 0.4 then
                done[target] = true
                collected += 1
                target, arrT = nil, nil
            end
        else
            arrT = nil
        end

        if target and dist < 6 and firetouchinterest and os.clock() - lastTouch > 0.15 then
            lastTouch = os.clock()
            pcall(firetouchinterest, hrp, target, 0)
            pcall(firetouchinterest, hrp, target, 1)
        end
    end)

    makeToggle(farmPage, 1, "cfCoin", "cfCoinD", function(v)
        FARM.on = v
        if not v then release() end
    end)
    NX.onUnload(function() FARM.on = false release() end)

    local afkOn = false
    local VirtualUser = game:GetService("VirtualUser")
    NX.bind(player.Idled, function()
        if afkOn then
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new(0, 0))
            end)
        end
    end)
    makeToggle(farmPage, 3, "afk", "afkD", function(v) afkOn = v end)
end--// ส่วน 8/12 : หมวดตัวละคร (ทะลุ สปีด กระโดด บิน TP กันฟลิ้ง)
do
    local P = { noclip = false, speed = false, jump = false, fly = false, tp = false, anti = false }
    local WALK_BASE, WALK_ADD = 16, 100
    local JUMP_BASE, JUMP_ADD = 50, 100
    local FLY_SPEED = 66

    local function myParts()
        local c = player.Character
        return c, c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
    end

    local orig = setmetatable({}, { __mode = "k" })
    local noclipWas = false
    NX.bind(RunService.Stepped, function()
        local c = player.Character
        if not c then return end
        if P.noclip and not NX.flinging then
            noclipWas = true
            for _, d in ipairs(c:GetDescendants()) do
                if d:IsA("BasePart") then
                    if orig[d] == nil then orig[d] = d.CanCollide end
                    d.CanCollide = false
                end
            end
        elseif noclipWas then
            noclipWas = false
            for part, v in pairs(orig) do
                if part.Parent then part.CanCollide = v end
                orig[part] = nil
            end
        end
    end)

    NX.bind(RunService.Heartbeat, function()
        local _, _, hum = myParts()
        if not hum then return end
        if P.speed then hum.WalkSpeed = WALK_BASE + WALK_ADD end
        if P.jump then
            hum.UseJumpPower = true
            hum.JumpPower = JUMP_BASE + JUMP_ADD
        end
    end)

    local flyBV, flyBG
    local function stopFly()
        if flyBV then flyBV:Destroy() flyBV = nil end
        if flyBG then flyBG:Destroy() flyBG = nil end
        local _, _, hum = myParts()
        if hum then hum.AutoRotate = true end
    end

    local function startFly()
        local _, hrp, hum = myParts()
        if not hrp then return end
        stopFly()
        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        flyBV.Velocity = Vector3.new(0, 0, 0)
        flyBV.Parent = hrp
        flyBG = Instance.new("BodyGyro")
        flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        flyBG.P = 9e4
        flyBG.CFrame = hrp.CFrame
        flyBG.Parent = hrp
        if hum then hum.AutoRotate = false end
    end

    NX.bind(RunService.RenderStepped, function()
        if not P.fly then return end
        if NX.flinging or NX.floating then
            if flyBV then stopFly() end
            return
        end
        local _, hrp, hum = myParts()
        local cam = workspace.CurrentCamera
        if not (hrp and hum and cam) then return end
        if not (flyBV and flyBV.Parent == hrp) then startFly() end
        if not flyBV then return end
        local look = cam.CFrame.LookVector
        local right = cam.CFrame.RightVector
        local fl = Vector3.new(look.X, 0, look.Z)
        local fr = Vector3.new(right.X, 0, right.Z)
        local vel = Vector3.new(0, 0, 0)
        local md = hum.MoveDirection
        if md.Magnitude > 0.05 and fl.Magnitude > 0.01 and fr.Magnitude > 0.01 then
            vel = (look * md:Dot(fl.Unit) + right * md:Dot(fr.Unit)) * FLY_SPEED
        end
        flyBV.Velocity = vel
        if flyBG and fl.Magnitude > 0.01 then
            flyBG.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + fl)
        end
    end)

    local tpTool
    local function giveTool()
        if tpTool and tpTool.Parent then return end
        local bp = player:FindFirstChild("Backpack")
        if not bp then return end
        tpTool = Instance.new("Tool")
        tpTool.Name = "TP NEXORA"
        tpTool.ToolTip = "TP NEXORA"
        tpTool.RequiresHandle = false
        tpTool.CanBeDropped = false
        tpTool.Activated:Connect(function()
            local c = player.Character
            local mouse = player:GetMouse()
            if c and mouse and mouse.Hit then
                c:PivotTo(CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0)))
            end
        end)
        tpTool.Parent = bp
    end

    task.spawn(function()
        while gui.Parent do
            task.wait(1)
            if P.tp then giveTool() end
        end
    end)

    NX.bind(RunService.Stepped, function()
        if not P.anti or NX.flinging then return end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character then
                for _, d in ipairs(plr.Character:GetDescendants()) do
                    if d:IsA("BasePart") then d.CanCollide = false end
                end
            end
        end
    end)

    NX.bind(RunService.Heartbeat, function()
        if not P.anti or NX.flinging then return end
        local _, hrp = myParts()
        if hrp and (hrp.AssemblyLinearVelocity.Magnitude > 250 or hrp.AssemblyAngularVelocity.Magnitude > 60) then
            hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end)

    makeToggle(playersPage, 1, "pNoclip", "pNoclipD", function(v) P.noclip = v end)
    makeToggle(playersPage, 2, "pSpeed", "pSpeedD", function(v)
        P.speed = v
        if not v then
            local _, _, hum = myParts()
            if hum then hum.WalkSpeed = WALK_BASE end
        end
    end)
    makeToggle(playersPage, 3, "pJump", "pJumpD", function(v)
        P.jump = v
        if not v then
            local _, _, hum = myParts()
            if hum then hum.JumpPower = JUMP_BASE end
        end
    end)
    makeToggle(playersPage, 4, "pFly", "pFlyD", function(v)
        P.fly = v
        if not v then stopFly() end
    end)
    makeToggle(playersPage, 5, "pTp", "pTpD", function(v)
        P.tp = v
        if v then giveTool() elseif tpTool then tpTool:Destroy() tpTool = nil end
    end)
